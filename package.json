  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets:build-liluo-character-frames",
    "dev": "vite",
    "prebuild:web": "npm run assets:build-liluo-character-frames",
    "build:web": "vite build",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
    "docs:check-encoding": "node scripts/docs/check-doc-encoding.js",
    "project:index:build": "node scripts/project-index/build-project-index.mjs --all",
