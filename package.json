    "segmentit": "^2.0.3",
    "vant": "^4.6.8",
    "vue": "^3.3.4",
    "vue-clipboard3": "^2.0.0",
    "vue-multi-select": "^4.6.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.51.1",
    "@vitejs/plugin-legacy": "^5.4.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "terser": "^5.46.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.0",
