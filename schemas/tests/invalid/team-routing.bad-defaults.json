{
  "schemaVersion": 1,
  "policyId": "liluo-creative-team-routing",
  "roster": "docs/设计记忆/项目组灵魂/team-roster.json",
  "defaults": {
    "tier": "solo",
    "maxParallelAgents": 9,
    "maxNestedDepth": 2,
    "formalViewRequiresActualInvocation": false
  },
  "tiers": [
    {
      "id": "solo",
      "minScore": 0,
      "maxScore": 1,
      "minAgents": 0,
      "maxAgents": 0
    },
    {
      "id": "micro-consult",
      "minScore": 2,
      "maxScore": 3,
      "minAgents": 1,
      "maxAgents": 1
    },
    {
      "id": "council",
      "minScore": 4,
      "maxScore": null,
      "minAgents": 2,
      "maxAgents": 3
    }
  ],
  "aggregation": {
    "withinRiskGroup": "max",
    "acrossRiskGroups": "sum",
    "mechanicalOnlyForcesSolo": true
  },
  "signals": [
    {
      "id": "x",
      "riskGroup": "mechanical",
      "score": 0,
      "preferredAgents": [],
      "match": {
        "taskAny": ["错字"],
        "pathAny": []
      }
    }
  ],
  "agentPriority": ["liluo_context_explorer"],
  "display": {
    "solo": "no-member-view",
    "micro-consult": "one-compact-member-view",
    "council": "two-or-three-compact-member-views-then-coordinator-conclusion",
    "uncalledMemberDisplay": "always"
  }
}
