{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG knowledge claim",
  "type": "object",
  "required": ["id", "content", "claimType", "evidenceRefs", "supportStatus", "reviewStatus", "origin"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "content": { "type": "string", "minLength": 1 },
    "claimType": {
      "enum": [
        "definition",
        "alias",
        "classification",
        "distinction",
        "usage",
        "creative-note",
        "warning",
        "project-canonical",
        "other"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "supportStatus": {
      "enum": [
        "supported",
        "partially-supported",
        "unsupported",
        "conflicted",
        "user-canonical",
        "pending"
      ]
    },
    "reviewStatus": {
      "enum": ["confirmed", "pending", "rejected"]
    },
    "origin": {
      "enum": ["user-authored", "ai-proposed", "external-summary"]
    }
  }
}
