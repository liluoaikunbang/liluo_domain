{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Skill source",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "displayName", "category", "repository", "trackedPaths", "storageMode", "trustTier", "license", "version", "updatePolicy", "security", "localUsage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "category": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "storageMode": { "enum": ["full-snapshot", "selected-files", "catalog-only", "metadata-only"] },
    "updatePolicy": {
      "type": "object",
      "properties": {
        "autoReplaceCurrentSnapshot": { "const": false },
        "autoModifyLocalSkills": { "const": false }
      }
    },
    "security": {
      "type": "object",
      "properties": { "trustedForDirectExecution": { "const": false } }
    }
  }
}
