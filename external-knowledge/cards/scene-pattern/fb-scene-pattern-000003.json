{
  "cardId": "fb-scene-pattern-000003",
  "cardType": "scene-pattern",
  "title": "封闭场景的探索与转场",
  "definition": "场景模式：在封闭或半封闭空间中，用环境线索、空间阻隔与可触发的转场条件组织探索节奏，使移动本身产生信息与代价。",
  "distinctions": [
    "探索服务于发现与转场，不是无目的闲逛。",
    "阻隔可以是物理的，也可以是规则、视线或协助条件。"
  ],
  "prerequisites": [
    "场景内至少存在一条可读的线索路径与一个未完全开放的出口。"
  ],
  "progression": [
    "建立空间边界与可用线索。",
    "角色在阻隔下尝试推进。",
    "触发转场或把阻隔升级为新问题。"
  ],
  "reversals": [
    "看似出口的通路把角色带回更深的封闭层。"
  ],
  "outcomes": [
    "进入新区域、新关系或新调查问题。",
    "保留未解阻隔作为后续回收点。"
  ],
  "concepts": [
    "环境线索",
    "空间阻隔",
    "转场触发"
  ],
  "abstractPatterns": [
    "环境线索",
    "空间阻隔",
    "转场触发"
  ],
