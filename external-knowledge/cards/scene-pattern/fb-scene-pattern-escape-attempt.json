{
  "cardId": "fb-scene-pattern-escape-attempt",
  "cardType": "scene-pattern",
  "title": "脱困尝试",
  "aliases": [
    "挣脱",
    "尝试脱困"
  ],
  "definition": "场景模式：角色在受限状态下尝试恢复行动权或退出条件。重点是尝试过程暴露信息、关系与失败代价，而不是保证立刻成功脱身。",
  "distinctions": [
    "脱困尝试是过程，不等于脱困成功。",
    "可发生在营救前后，也可单独成为调查或交涉的触发器。"
  ],
  "prerequisites": [
    "角色仍保有至少一种可尝试的退出路径或误判路径。"
  ],
  "progression": [
    "角色按原计划尝试退出。",
    "环境、身体状态或协助条件给出反馈。",
    "成功、部分成功或失败把事件推入新的选择面。"
  ],
  "reversals": [
    "表面脱困成功，却触发更大范围的暴露或追责。"
  ],
  "outcomes": [
    "留下新线索、伤势或关系裂痕。",
    "把“还能不能自己结束”变成后续冲突的核心。"
  ],
  "concepts": [
    "脱困尝试",
    "挣脱",
    "尝试脱困"
  ],
  "abstractPatterns": [
    "尝试—反馈—代价",
    "退出权再判断"
  ],
  "tags": [
    "叙事:逃脱",
    "状态:受限",
    "氛围:悬疑",
    "叙事:调查"
  ],
