# Copy this file to `.env.runtime-assets.local` and fill the real values there.
# Do not commit `.env.runtime-assets.local`.

# Local provider used for private runtime assets. Current design assumes Nutstore.
LILUO_RUNTIME_ASSET_PROVIDER=nutstore

# Absolute path to the locally synced private asset root.
# Example on Windows:
# D:\Nutstore\liluo-universe-private-assets
LILUO_RUNTIME_ASSET_SYNC_ROOT=

# Optional. Leave empty to use the repo default manifest.
LILUO_RUNTIME_ASSET_MANIFEST=
