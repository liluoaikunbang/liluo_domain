# Copy this file to `.env.assets.local` and fill the real values there.
# Do not commit `.env.assets.local`.

# Cloudflare R2 account information
LILUO_ASSET_R2_ACCOUNT_ID=
LILUO_ASSET_R2_ACCESS_KEY_ID=
LILUO_ASSET_R2_SECRET_ACCESS_KEY=

# Bucket and endpoint
LILUO_ASSET_R2_BUCKET=liluo-universe-assets
LILUO_ASSET_R2_REGION=auto

# Leave empty to derive from ACCOUNT_ID, or set a custom S3-compatible endpoint explicitly.
LILUO_ASSET_R2_ENDPOINT=

# Public asset base URL. Prefer the custom domain you bind to the bucket, for example:
# https://assets.example.com
LILUO_ASSET_R2_PUBLIC_BASE_URL=
