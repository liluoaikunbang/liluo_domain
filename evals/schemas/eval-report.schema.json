{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liluo.local/evals/eval-report.schema.json",
  "title": "璃落能力评测报告",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "suite", "summary", "results", "tokenUsage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "suite": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "target", "status", "failures", "resultFile", "tokenUsage"],
        "properties": {
          "caseId": { "type": "string" },
          "target": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "SKIPPED"] },
          "failures": { "type": "array", "items": { "type": "object" } },
          "resultFile": { "type": "string" },
          "skipReason": { "type": "string" },
          "tokenUsage": { "$ref": "#/$defs/tokenUsage" }
        }
      }
    },
    "tokenUsage": { "$ref": "#/$defs/tokenUsage" }
  },
  "$defs": {
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cachedInput", "output", "total"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "cachedInput": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
